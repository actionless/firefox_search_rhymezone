{
	"manifest_version": 2,
	"name": "search_rhymezone",
	"version": "0.1",
	"description": "Search RhymeZone",

	"icons": {
		"48": "icons/icon.png",
		"96": "icons/icon@2x.png"
	},

	"chrome_settings_overrides": {
	  "search_provider": {
		"name": "RhymeZone",
		"search_url": "https://www.rhymezone.com/r/rhyme.cgi?Word={searchTerms}&typeofrhyme=perfect&org1=syl&org2=l&org3=y",
		"keyword": "rh",
		"favicon_url": "/icons/favicon.ico"
	  }
	},

	"browser_specific_settings": {
		"gecko": {
			"data_collection_permissions": {
				"required": ["none"]
			},
			"id": "firefox_search_rhymezone@actionless.github.com",
			"strict_min_version": "142.0"
		}
	}
}
